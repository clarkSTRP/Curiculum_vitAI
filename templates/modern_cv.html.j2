<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>CV - {{ identity.full_name }}</title>
    <link rel="stylesheet" href="../templates/styles/style.css">
</head>

<body>
    <div class="page">

        <aside class="sidebar">
            {% if identity.photo %}
            <div class="photo-container">
                <img src="../{{ identity.photo }}" alt="Photo de profil" class="profile-photo">
            </div>
            {% endif %}

            <section class="sidebar-section">
                <h2>Contact</h2>

                {% if identity.phone %}
                <p><span>Téléphone</span>{{ identity.phone }}</p>
                {% endif %}

                {% if identity.email %}
                <p><span>Email</span>{{ identity.email }}</p>
                {% endif %}

                {% if identity.location %}
                <p><span>Localisation</span>{{ identity.location }}</p>
                {% endif %}
            </section>

            {% if skills %}
            <section class="sidebar-section">
                <h2>Compétences</h2>

                {% if skills.cybersecurity %}
                <h3>Cybersécurité</h3>
                <div class="tag-list">
                    {% for skill in skills.cybersecurity %}
                    <span class="tag">{{ skill }}</span>
                    {% endfor %}
                </div>
                {% endif %}

                {% if skills.programming %}
                <h3>Programmation</h3>
                <div class="tag-list">
                    {% for skill in skills.programming %}
                    <span class="tag">{{ skill }}</span>
                    {% endfor %}
                </div>
                {% endif %}

                {% if skills.infrastructure %}
                <h3>Infrastructure</h3>
                <div class="tag-list">
                    {% for skill in skills.infrastructure %}
                    <span class="tag">{{ skill }}</span>
                    {% endfor %}
                </div>
                {% endif %}

                {% if skills.systems %}
                <h3>Systèmes</h3>
                <div class="tag-list">
                    {% for skill in skills.systems %}
                    <span class="tag">{{ skill }}</span>
                    {% endfor %}
                </div>
                {% endif %}

                {% if skills.network %}
                <h3>Réseau</h3>
                <div class="tag-list">
                    {% for skill in skills.network %}
                    <span class="tag">{{ skill }}</span>
                    {% endfor %}
                </div>
                {% endif %}
            </section>
            {% endif %}

            {% if languages %}
            <section class="sidebar-section">
                <h2>Langues</h2>

                {% for lang in languages %}
                <p>
                    <span>{{ lang.language }}</span>
                    {{ lang.level }}
                    {% if lang.details %}
                    <br>
                    <small>{{ lang.details | join(", ") }}</small>
                    {% endif %}
                </p>
                {% endfor %}
            </section>
            {% endif %}

            {% if mobility %}
            <section class="sidebar-section">
                <h2>Mobilité</h2>

                <p>
                    {% if mobility.driving_license %}
                    {{ mobility.driving_license }}
                    {% endif %}

                    {% if mobility.motorized %}
                    <br>Motorisé
                    {% endif %}
                </p>
            </section>
            {% endif %}
        </aside>

        <main class="content">
            <header class="header">
                <h1>{{ identity.full_name }}</h1>
                <p class="title">{{ identity.title }}</p>
            </header>

            {% if summary %}
            <section class="main-section">
                <h2>Profil</h2>
                <p class="summary">{{ summary }}</p>
            </section>
            {% endif %}

            {% if professional_experience %}
            <section class="main-section">
                <h2>Expériences professionnelles</h2>

                {% for exp in professional_experience %}
                <article class="experience">
                    <div class="experience-header">
                        <div>
                            <h3>{{ exp.position }}</h3>
                            <p class="company">{{ exp.company }}</p>
                        </div>

                        <div class="date">
                            {{ exp.start_date }} - {{ exp.end_date }}
                        </div>
                    </div>

                    <div class="experience-meta">
                        {% if exp.location %}
                        <span>{{ exp.location }}</span>
                        {% endif %}

                        {% if exp.contract_type %}
                        <span>{{ exp.contract_type }}</span>
                        {% endif %}
                    </div>

                    {% if exp.missions %}
                    <ul>
                        {% for mission in exp.missions %}
                        <li>{{ mission }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </article>
                {% endfor %}
            </section>
            {% endif %}

            {% if education %}
            <section class="main-section">
                <h2>Formation</h2>

                {% for edu in education %}
                <article class="education">
                    <div class="experience-header">
                        <div>
                            <h3>{{ edu.degree }}</h3>
                            <p class="company">{{ edu.school }}</p>
                        </div>

                        <div class="date">
                            {{ edu.start_date }} - {{ edu.end_date }}
                        </div>
                    </div>
                </article>
                {% endfor %}
            </section>
            {% endif %}
        </main>

    </div>
</body>
</html>